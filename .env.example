# Copy to .env on the server and replace every sample value.
# Never include your real .env file in a ZIP, email, or source control.
ELDF_SQLSERVER_CONNECTION_STRING="Server=YOUR_SQL_SERVER;Database=LangDataPlatform;User Id=YOUR_DATABASE_USER;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=true;"
# Set this to the exact website origin (no trailing slash). Same-origin deployment is preferred.
ELDF_ALLOWED_ORIGINS=https://YOUR_WEBSITE_DOMAIN
# Keep true behind HTTPS. For local HTTP testing only, set false.
ELDF_COOKIE_SECURE=true
ELDF_ADMIN_PHONES=+2519XXXXXXXX
ELDF_AGENT_PHONES=
ELDF_ADMIN_ENROLLMENT_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
ELDF_AGENT_ENROLLMENT_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
